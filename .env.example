# Copie para .env.local (nunca commite chaves reais).
# As chaves só são usadas quando você testa a conexão ou envia uma mensagem.

GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Opcional: desligar a API Gemini direta na sua máquina.
# ANTESSALA_GEMINI_ENABLE=0

# Opcional: banco isolado para desenvolvimento/provas.
# ANTESSALA_DB_PATH=/caminho/para/antessala-pg
