{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/renderer/src/paginas/MemoriaPagina.tsx",
    "src/renderer/src/componentes/AdicionarConhecimentoDialog.tsx",
    "src/renderer/src/componentes/RagPlayground.tsx",
    "src/renderer/src/componentes/VerConhecimentoDialog.tsx",
    "src/renderer/src/componentes/ai/AiRoutingSection.tsx",
    "src/renderer/src/hooks/useImageBlobUrl.ts",
    "src/renderer/src/servicos/conhecimento.ts",
    "src/renderer/src/servicos/memorias.ts",
    "src/shared/ai-runtime-contract.ts",
    "src/shared/ia-routing-contract.ts"
  ]
}
