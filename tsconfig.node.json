{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./out",
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": [
    "src/main/knowledge/**",
    "src/main/importers/**",
    "src/main/jobs.ts",
    "src/main/ia/discovery.ts",
    "src/main/ia/metadata-generator.ts",
    "src/main/ia/readiness.ts",
    "src/main/ia/route-config.ts",
    "src/main/ia/routing.ts",
    "src/main/ia/session-processor.ts",
    "src/main/ia/system-prompt.ts",
    "src/shared/ai-runtime-contract.ts",
    "src/shared/ia-routing-contract.ts"
  ]
}
